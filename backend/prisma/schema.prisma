// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  username  String   @unique
  password  String
  firstName String
  lastName  String
  avatar    String?
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  contacts    Contact[]
  tripGroups  TripGroup[]
  messages    Message[]
  groupMembers GroupMember[]
  notes       Note[]

  @@map("users")
}

model Note {
  id          String        @id @default(cuid())
  title       String
  content     String?
  reminderAt  DateTime?
  followUp    FollowUpStatus @default(NONE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  createdById String

  // Relationships
  createdBy User @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@map("notes")
}

model Contact {
  id          String   @id @default(cuid())
  firstName   String
  lastName    String
  email       String?
  phone       String?
  address     String?
  notes       String?
  avatar      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String

  // Relationships
  createdBy    User          @relation(fields: [createdById], references: [id], onDelete: Cascade)
  tags         ContactTag[]
  groupMembers GroupMember[]
  lists        ListMember[]

  @@map("contacts")
}

model Tag {
  id          String   @id @default(cuid())
  name        String
  value       String?
  color       String   @default("#3B82F6")
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relationships
  contacts ContactTag[]
  lists    List[]

  @@unique([name, value])
  @@map("tags")
}

model ContactTag {
  id        String @id @default(cuid())
  contactId String
  tagId     String

  // Relationships
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([contactId, tagId])
  @@map("contact_tags")
}

model List {
  id          String   @id @default(cuid())
  name        String
  description String?
  isAutomatic Boolean  @default(true)
  tagId       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relationships
  tag     Tag?         @relation(fields: [tagId], references: [id], onDelete: SetNull)
  members ListMember[]

  @@map("lists")
}

model ListMember {
  id        String @id @default(cuid())
  listId    String
  contactId String

  // Relationships
  list    List    @relation(fields: [listId], references: [id], onDelete: Cascade)
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([listId, contactId])
  @@map("list_members")
}

model TripGroup {
  id           String     @id @default(cuid())
  name         String
  description  String?
  destination  String?
  startDate    DateTime?
  endDate      DateTime?
  budget       Float?
  status       TripStatus @default(PLANNING)
  coverImage   String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  createdById  String

  // Relationships
  createdBy   User          @relation(fields: [createdById], references: [id], onDelete: Cascade)
  members     GroupMember[]
  itineraries Itinerary[]
  expenses    Expense[]
  messages    Message[]
  kanbanCards KanbanCard[]
  tickets     Ticket[]

  @@map("trip_groups")
}

model Ticket {
  id          String       @id @default(cuid())
  groupId     String
  title       String
  category    String?       // e.g. Flight, Hotel, Train — for list grouping (§6.6)
  type        TicketType   @default(TICKET) // for smart card icon/layout (§7.1)
  filePath    String?      // server path to attached file
  fileName    String?      // original file name
  ocrData     Json?        // extracted fields: carrier, time, seat, gate, PNR, etc.
  ocrStatus   OcrStatus    @default(NONE)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  group TripGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@map("tickets")
}

model KanbanCard {
  id          String       @id @default(cuid())
  groupId     String
  title       String
  description String?
  status      KanbanStatus  @default(TODO)
  position    Int           @default(0)
  assigneeId  String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  group TripGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@map("kanban_cards")
}

model GroupMember {
  id          String     @id @default(cuid())
  groupId     String
  contactId   String?
  userId      String?
  role        MemberRole @default(MEMBER)
  joinedAt    DateTime   @default(now())
  isConfirmed Boolean    @default(false)

  // Relationships
  group   TripGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  contact Contact?  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  user    User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, contactId])
  @@unique([groupId, userId])
  @@map("group_members")
}

model Itinerary {
  id          String    @id @default(cuid())
  groupId     String
  title       String
  description String?
  location    String?
  startTime   DateTime
  endTime     DateTime?
  cost        Float?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relationships
  group TripGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@map("itineraries")
}

model Expense {
  id          String      @id @default(cuid())
  groupId     String
  title       String
  description String?
  amount      Float
  category    String
  paidBy      String?
  splitType   SplitType   @default(EQUAL)
  date        DateTime    @default(now())
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  // Relationships
  group TripGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@map("expenses")
}

model Message {
  id        String      @id @default(cuid())
  content   String
  type      MessageType @default(TEXT)
  groupId   String?
  senderId  String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  // Relationships
  group  TripGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)
  sender User       @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@map("messages")
}

enum Role {
  USER
  ADMIN
}

enum TripStatus {
  PLANNING
  CONFIRMED
  ONGOING
  COMPLETED
  CANCELLED
}

enum MemberRole {
  ORGANIZER
  CO_ORGANIZER
  MEMBER
  VOLUNTEER
}

enum SplitType {
  EQUAL
  CUSTOM
  PERCENTAGE
}

enum MessageType {
  TEXT
  IMAGE
  FILE
  ANNOUNCEMENT
}

enum FollowUpStatus {
  NONE
  PENDING
  DONE
}

enum KanbanStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum TicketType {
  TICKET
  HOTEL
  BILL
  BOOKING
  DOCUMENT
}

enum OcrStatus {
  NONE
  PENDING
  COMPLETED
  FAILED
}